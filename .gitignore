# ========== Python / 后端 ==========
# 虚拟环境
backend/.venv/
backend/.venv-*/

# Python缓存
__pycache__/
*.pyc
*.pyo
*.pyd
*.so

# 私密环境变量（真实密钥，不要上传）
backend/.env
# .env.example 是示例，保留不忽略！

# 上传的用户文件
backend/uploads/

# ========== Vue / Vite 前端 ==========
# node依赖包，体积巨大，不上传
frontend/node_modules/
# vite打包产物
frontend/dist/
frontend/.vite/

# 前端本地环境变量（真实配置）
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local

# ========== VSCode 编辑器配置 ==========
.vscode/

# ========== 系统临时文件 ==========
.DS_Store
Thumbs.db
